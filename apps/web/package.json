{
  "name": "@org/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "@org/backend:serve"
        ],
        "continuous": true,
        "options": {
          "args": [
            "--port=3000"
          ]
        }
      },
      "start": {
        "options": {
          "args": [
            "--port=3000"
          ]
        }
      },
      "serve-static": {
        "options": {
          "args": [
            "--port=3000"
          ]
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
